NODE_ENV=development
PORT=5000
SERVER_ORIGIN=http://localhost:5000
MONGODB_URI=mongodb://127.0.0.1:27017/pswcares
JWT_SECRET=replace-with-a-strong-jwt-secret
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
S3_SIGNED_URL_TTL_SECONDS=900
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
STRIPE_SUCCESS_URL=http://localhost:5000/api/payments/success
STRIPE_CANCEL_URL=http://localhost:5000/api/payments/cancel

# Secure admin seeding (used only by npm run seed:admin)
ADMIN_SEED_NAME=Platform Admin
ADMIN_SEED_EMAIL=admin@pswcares.local
ADMIN_SEED_PASSWORD=replace-with-a-strong-admin-password
ADMIN_SEED_TOKEN=replace-with-a-long-random-seed-token
